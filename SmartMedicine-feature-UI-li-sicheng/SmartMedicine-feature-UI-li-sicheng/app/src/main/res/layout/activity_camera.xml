<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 相机预览视图 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/camera_control_layout" />

    <!-- 顶部控制栏 -->
    <LinearLayout
        android:id="@+id/top_control_layout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <!-- 返回按钮 -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_light_gray"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@android:color/white" />

        <!-- 标题 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="药品拍摄"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 空白占位 -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/camera_control_layout"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentBottom="true"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <!-- 空白占位 -->
        <View
            android:layout_width="60dp"
            android:layout_height="60dp" />

        <!-- 拍摄按钮 -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_capture"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_light"
            android:padding="10dp"
            android:src="@drawable/ic_check"
            android:tint="@android:color/black" />

        <!-- 空白占位 -->
        <View
            android:layout_width="60dp"
            android:layout_height="60dp" />
    </LinearLayout>

    <!-- 拍摄提示文字 -->
    <TextView
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/camera_control_layout"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_circle_light_gray"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="请对准药品拍摄"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <!-- 加载指示器 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone" />

</RelativeLayout>